# Private key of the relayer wallet (must hold FLOW tokens for gas on Flow EVM Testnet)
# Generate a dedicated wallet — never reuse a personal key here.
RELAYER_PRIVATE_KEY=0xabc123...your-relayer-private-key

# Flow EVM RPC endpoint (defaults to testnet if omitted)
FLOW_EVM_RPC=https://testnet.evm.nodes.onflow.org

# HTTP port the relayer listens on (default 3001)
PORT=3001

# Comma-separated list of frontend origins allowed to call this server
# Use * only during local development
CORS_ORIGIN=http://localhost:3000
